# ⚠️ SECURITY WARNING ⚠️
# This is an example environment file. DO NOT commit actual secrets to version control.
# Copy this file to .env and fill in your actual values.
# Never share your .env file or commit it to git (it's in .gitignore).

# MongoDB Configuration
# Use a strong password and restrict network access
# For production, use MongoDB Atlas with IP whitelisting
MONGO_URI=mongodb://127.0.0.1:27017/fishing-chrome-extension

# Server Configuration
PORT=5005
NODE_ENV=development

# CORS Configuration
# In production, specify only your actual extension ID and domains
# Format: chrome-extension://YOUR_EXTENSION_ID,https://yourdomain.com
ALLOWED_ORIGINS=

# JWT Secret - CRITICAL SECURITY
# Generate a strong random secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use a weak or default secret in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Stripe Configuration - SENSITIVE PAYMENT DATA
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys for development (pk_test_*, sk_test_*)
# Use live keys ONLY in production (pk_live_*, sk_live_*)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_no_spaces
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id

# Frontend URL
# The URL where your extension popup will be loaded
# Format: chrome-extension://YOUR_EXTENSION_ID/popup/popup.html
FRONTEND_URL=chrome-extension://your_extension_id/popup/popup.html

# ============================================================================
# SECURITY BEST PRACTICES:
# ============================================================================
# 1. Use strong, unique passwords for all services
# 2. Enable 2FA on all accounts (MongoDB, Stripe, etc.)
# 3. Regularly rotate secrets and API keys
# 4. Use environment-specific configurations (dev, staging, prod)
# 5. Never log sensitive data (passwords, tokens, API keys)
# 6. Keep dependencies updated: npm audit && npm update
# 7. Use HTTPS in production
# 8. Implement rate limiting (already included)
# 9. Monitor for suspicious activity
# 10. Regular security audits
