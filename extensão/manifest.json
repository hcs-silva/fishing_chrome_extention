{
  "manifest_version": 3,
  "name": "Fishing Tides PT",
  "version": "1.0.0",
  "description": "Marés, ondas e actividade de peixe em Portugal",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "geolocation"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5005/*",
    "https://fishing-chrome-extention.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
